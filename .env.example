# SPoHF API
WP6_API_BASE_URL=https://backoffice.spohf.com
WP6_API_TOKEN=your-bearer-token-here

# Neo4j (local Docker: bolt://, Aura: bolt+s://)
WP6_NEO4J_URI=bolt://localhost:7687
WP6_NEO4J_USER=neo4j
WP6_NEO4J_PASSWORD=localdevpassword

# Sync behavior
WP6_SYNC_LOOKBACK_HOURS=24
WP6_SYNC_PAGE_SIZE=1000
WP6_SYNC_MAX_PAGES=1000
WP6_ENDPOINTS=yookr-data
WP6_SYNC_MODE=auto  # auto, windowed (full historical), or incremental
WP6_SYNC_WINDOW_DAYS=1  # Days per window in windowed mode (use 30 for monthly)

# Logging
WP6_LOG_LEVEL=INFO
WP6_LOG_FORMAT=console

# RED Dashboard (MySQL backend)
WP6_RED_DB_HOST=localhost
WP6_RED_DB_PORT=3306
WP6_RED_DB_NAME=spohf2
WP6_RED_DB_USER=your-mysql-user
WP6_RED_DB_PASSWORD=your-mysql-password

# RED OIDC authentication (Keycloak)
WP6_RED_OIDC_ISSUER=https://auth.fontysvenlo.dev/realms/spohf
WP6_RED_OIDC_CLIENT_ID=wp6-red-dashboard
WP6_RED_OIDC_CLIENT_SECRET=your-client-secret-from-keycloak
WP6_RED_SESSION_SECRET=generate-a-random-32-char-string
WP6_RED_ADMIN_GROUP=/wp6-admins

# RED weather/location settings (for DLI predictions)
WP6_RED_WEATHER_LAT=51.033056        # Greenhouse latitude
WP6_RED_WEATHER_LON=6.613721         # Greenhouse longitude

# RED ML model path (optional - defaults to .models/light_model.pkl in project dir)
# WP6_RED_DLI_MODEL_PATH=/data/models/light_model.pkl

# DLI attenuation override (for testing/simulation, default is trained value
#WP6_RED_DLI_ATTENUATION_OVERRIDE=0.62